{
  "name": "werkaholic-ai-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "electron .",
    "app:dev": "vite & sleep 3 && electron .",
    "app:preview": "npm run build && electron .",
    "app:dist:linux": "electron-builder --linux AppImage --x64",
    "app:dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.11",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "ai.werkaholic.remake",
    "productName": "Werkscan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${os}.${ext}"
    }
  }
}
